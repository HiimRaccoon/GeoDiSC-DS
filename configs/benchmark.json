{
  "classifier": {
    "model": "EfficientNet-B0",
    "weights": "IMAGENET1K_V1",
    "full_backbone": true,
    "head": [
      1280,
      124
    ],
    "dropout": 0.2,
    "batch_size": 128,
    "input_shape": [
      3,
      384,
      896
    ],
    "epochs": 20,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "precision": "FP32",
    "amp": false,
    "optimizer": {
      "name": "AdamW",
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-08,
      "amsgrad": false,
      "maximize": false,
      "foreach": false,
      "fused": false,
      "capturable": false,
      "differentiable": false,
      "single_parameter_group": true
    },
    "scheduler": {
      "warmup_epochs": 1,
      "warmup_start_factor": 0.1,
