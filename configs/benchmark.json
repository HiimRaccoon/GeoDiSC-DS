      "num_workers": 4,
      "pin_memory": true,
      "persistent_workers": false,
      "prefetch_factor": 2,
      "drop_last": false,
      "weighted_sampler": false,
      "train_shuffle": true,
      "eval_shuffle": false,
      "train_replacement": false,
      "deterministic_algorithms": true,
      "cudnn_benchmark": false,
      "cudnn_deterministic": true,
      "cublas_workspace_config": ":4096:8",
      "default_mixup": false,
      "cutmix": false
